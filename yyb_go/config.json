{
  "name": "YYB-Go Enhanced",
  "version": "1.1.3",
  "slug": "yyb_go",
  "description": "YYB-Go Enhanced 的 Home Assistant OS Add-on 封装，采用上游单容器 Web/认证架构，并支持青龙自动发现与持久化。",
  "url": "https://github.com/windowlife/yyb_go_addons",
  "startup": "application",
  "boot": "auto",
  "init": false,
  "arch": [
    "amd64",
    "aarch64"
  ],
  "hassio_api": true,
  "hassio_role": "manager",
  "ports": {
    "8000/tcp": 8000
  },
  "ports_description": {
    "8000/tcp": "YYB-Go Web UI / API"
  },
  "webui": "http://[HOST]:[PORT:8000]/",
  "watchdog": "http://[HOST]:[PORT:8000]/health",
  "options": {
    "keepalive_interval": "30m",
    "keepalive_ahead": "45m",
    "ql_url": "",
    "ql_client_id": "",
    "ql_client_secret": "",
    "yyb_qinglong_repo": "SuperNaiBA_YYB-GO-Script,525815266_YYB-Go-Enhanced/scripts",
    "yyb_cookie_secure": false
  },
  "schema": {
    "keepalive_interval": "str",
    "keepalive_ahead": "str",
    "ql_url": "str",
    "ql_client_id": "str",
    "ql_client_secret": "password",
    "yyb_qinglong_server": "str?",
    "yyb_qinglong_repo": "str",
    "yyb_admin_user": "str?",
    "yyb_admin_password": "password?",
    "yyb_cookie_secure": "bool"
  }
}
